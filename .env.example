# =====================================================================
# AI Attendance System - example configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so
# never put a real credential in here.
#
#   cp .env.example .env
#
# Every value below has a default in config/settings.py except SECRET_KEY,
# which is required. A missing SECRET_KEY is a deliberate startup failure.
# =====================================================================


# ---------------------------------------------------------------------
# FLASK
# ---------------------------------------------------------------------
# REQUIRED. Minimum 16 characters. Generate a fresh one per deployment:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# This signs session cookies. Anyone who knows it can forge a session and
# log in as admin, so it must never be committed or shared between
# environments. The previous hardcoded value is in git history and must
# not be reused.
SECRET_KEY=replace-me-with-a-generated-value

# Never enable in anything reachable by another machine: Flask's debugger
# exposes an interactive Python console on any unhandled exception.
FLASK_DEBUG=false


# ---------------------------------------------------------------------
# SESSIONS (SE-11)
# ---------------------------------------------------------------------
# Send the session cookie only over HTTPS.
#
# Defaults to false, and that is deliberate rather than lax: this system
# runs on Flask's development server over plain HTTP (PO-4). With `true`
# on an HTTP origin the browser never sends the cookie back, so nobody
# can log in at all. Set it to true the moment there is TLS in front.
SESSION_COOKIE_SECURE=false

# Idle timeout in minutes. Classroom machines are shared, so an
# unattended browser should not stay signed in indefinitely.
SESSION_LIFETIME_MINUTES=30


# ---------------------------------------------------------------------
# LOGIN THROTTLING (SE-13)
# ---------------------------------------------------------------------
# Consecutive failures per (username, client address) before the account
# is locked, and for how long. Counters are held in memory, so they are
# cleared by a restart - see security/rate_limit.py for why that is an
# accurate model of this deployment rather than a shortcut.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# A quiet spell longer than this forgives earlier failures, so occasional
# typos never accumulate into a lockout.
LOGIN_ATTEMPT_WINDOW_SECONDS=900


# ---------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendancesystem_db


# ---------------------------------------------------------------------
# RECOGNITION
# ---------------------------------------------------------------------
# LBPH distance below which a match is accepted. Lower is stricter.
#
# Do not tune this in isolation. It is calibrated against the distance
# scale produced by LBPH_PARAMS in train_model.py, which is deliberately
# NOT configurable here. Changing `neighbors` once shifted distances from
# ~35 to 81-107 while this stayed at 58.0, and the system silently
# rejected every face - 0/60 on a held-out split, with no error raised.
# See tasks/lessons.md L2.
#
# 58.0 is the measured-working value. A justified operating point derived
# from FAR/FRR/EER is Phase 6 work.
RECOGNITION_THRESHOLD=58.0


# ---------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
#
# DEBUG enables the per-frame recognition diagnostics in
# recognize_face.generate_frames(). They fire per face per frame, so
# expect the log to grow fast - useful for diagnosing a recognition
# problem, unusable as a steady state.
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5


# ---------------------------------------------------------------------
# PATHS
# ---------------------------------------------------------------------
# Absolute, or relative to the repository root. Both hold sensitive
# personal information under RA 10173 - face images and the biometric
# templates derived from them - and both are gitignored. If you point
# these somewhere new, make sure the new location is ignored too.
# DATASET_DIR=dataset
# TRAINER_DIR=trainer
