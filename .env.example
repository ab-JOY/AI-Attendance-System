# =====================================================================
# AI Attendance System - example configuration
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not, so
# never put a real credential in here.
#
#   cp .env.example .env
#
# Every value below has a default in config/settings.py except SECRET_KEY,
# which is required. A missing SECRET_KEY is a deliberate startup failure.
# =====================================================================


# ---------------------------------------------------------------------
# FLASK
# ---------------------------------------------------------------------
# REQUIRED. Minimum 16 characters. Generate a fresh one per deployment:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# This signs session cookies. Anyone who knows it can forge a session and
# log in as admin, so it must never be committed or shared between
# environments. The previous hardcoded value is in git history and must
# not be reused.
SECRET_KEY=replace-me-with-a-generated-value

# Never enable in anything reachable by another machine: Flask's debugger
# exposes an interactive Python console on any unhandled exception.
FLASK_DEBUG=false


# ---------------------------------------------------------------------
# SESSIONS (SE-11)
# ---------------------------------------------------------------------
# Send the session cookie only over HTTPS.
#
# ⚠️ **Leave this unset.** It now follows whether SSL_CERT_FILE and
# SSL_KEY_FILE are configured, so the flag turns itself on the day TLS
# arrives rather than being a note somebody has to act on. Setting it
# true on an HTTP origin means the browser never sends the cookie back
# and nobody can log in at all; leaving it false once there is TLS puts
# session cookies in clear on the wire.
#
# Set it explicitly only behind a TLS-terminating proxy, where this
# process speaks HTTP but the browser does not:
#
# SESSION_COOKIE_SECURE=true

# Idle timeout in minutes. Classroom machines are shared, so an
# unattended browser should not stay signed in indefinitely.
SESSION_LIFETIME_MINUTES=30


# ---------------------------------------------------------------------
# LOGIN THROTTLING (SE-13)
# ---------------------------------------------------------------------
# Consecutive failures per (username, client address) before the account
# is locked, and for how long. Counters are held in memory, so they are
# cleared by a restart - see security/rate_limit.py for why that is an
# accurate model of this deployment rather than a shortcut.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# A quiet spell longer than this forgives earlier failures, so occasional
# typos never accumulate into a lockout.
LOGIN_ATTEMPT_WINDOW_SECONDS=900


# ---------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=attendancesystem_db

# Bring the schema up to date automatically when `python app.py` starts.
#
# Leave this on when running the system on your own machine. It is what stops
# a copy of a newer version silently running against a database created by an
# older one: CREATE TABLE IF NOT EXISTS is a no-op on an existing table, so
# without it the application starts and then fails on whichever page first
# touches a column that was never added.
#
# Turn it off anywhere that runs more than one process. Two workers starting
# at once would both try to apply the same migration and nothing takes a lock;
# `python scripts/migrate.py` is the deliberate alternative.
AUTO_MIGRATE=true


# ---------------------------------------------------------------------
# RECOGNITION
# ---------------------------------------------------------------------
# LBPH distance below which a match is accepted. Lower is stricter.
#
# Do not tune this in isolation. It is calibrated against the distance
# scale produced by LBPH_PARAMS in train_model.py, which is deliberately
# NOT configurable here. Changing `neighbors` once shifted distances from
# ~35 to 81-107 while this stayed at 58.0, and the system silently
# rejected every face - 0/60 on a held-out split, with no error raised.
# See tasks/lessons.md L2.
#
# 58.0 is the measured-working value. A justified operating point derived
# from FAR/FRR/EER is Phase 6 work.
RECOGNITION_THRESHOLD=58.0


# ---------------------------------------------------------------------
# LOGGING
# ---------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
#
# DEBUG enables the per-frame recognition diagnostics in
# recognize_face.generate_frames(). They fire per face per frame, so
# expect the log to grow fast - useful for diagnosing a recognition
# problem, unusable as a steady state.
LOG_LEVEL=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5


# ---------------------------------------------------------------------
# PATHS
# ---------------------------------------------------------------------
# Absolute, or relative to the repository root. Both hold sensitive
# personal information under RA 10173 - face images and the biometric
# templates derived from them - and both are gitignored. If you point
# these somewhere new, make sure the new location is ignored too.
# DATASET_DIR=dataset
# TRAINER_DIR=trainer


# ---------------------------------------------------------------------
# TLS (CO-3)
# ---------------------------------------------------------------------
# Both or neither. One without the other is a startup failure, not a
# quiet fall back to HTTP - an operator who set a certificate and got
# plain HTTP anyway would have no way to tell, and the symptom they would
# chase is a camera that does not work.
#
# ⚠️ Browser enrolment calls getUserMedia, which browsers expose only in
# a SECURE CONTEXT: HTTPS, or http://localhost. With no certificate here,
# enrolment works on the server machine and nowhere else. There is no
# flag and no prompt - the call is simply rejected.
#
# Generate a development certificate with correct Subject Alternative
# Names (a certificate without them is refused outright, and no
# click-through overrides it):
#
#   python scripts/make_dev_cert.py
#
# Better, if you can install it: mkcert also puts a local CA in the
# system trust store, so there is no browser warning at all.
#
#   mkcert -install
#   mkcert -cert-file certs/dev-cert.pem -key-file certs/dev-key.pem \
#       localhost 127.0.0.1 <this machine's LAN IP>
#
# ⚠️ The key is a credential. certs/, *.pem, *.key and *.crt are
# gitignored; never commit one.
#
# SSL_CERT_FILE=certs/dev-cert.pem
# SSL_KEY_FILE=certs/dev-key.pem
